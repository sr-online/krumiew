rules_version = '2';
// กฎสำหรับระบบส่งงาน: เปิดเฉพาะคอลเลกชันที่ระบบใช้
service cloud.firestore {
  match /databases/{database}/documents {
    match /subjects/{id}        { allow read, write: if true; }
    match /assignments/{id}     { allow read, write: if true; }
    match /students/{id}        { allow read, write: if true; }
    match /submissions/{id}     { allow read, write: if true; }
    match /submissionFiles/{id} { allow read, write: if true; }
    match /gradebooks/{id}      { allow read, write: if true; }
    match /settings/{id}        { allow read, write: if true; }
  }
}
